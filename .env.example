# Frontend Configuration Example
# Copy this file to .env and configure according to your setup

# ============================================
# Application Settings
# ============================================

# Company/Organization Name
VITE_COMPANY_NAME="Nazwa twojej firmy"
# Example: VITE_COMPANY_NAME="Grand Army of The Republic"

# Employee/Worker Name (singular form)
VITE_EMPLOYEE="Pracownik"
# Example: VITE_EMPLOYEE="Clone Trooper"

# ============================================
# Backend API Configuration  
# ============================================

# Backend REST API URL
VITE_API_URL="http://localhost:3000"
# Example: VITE_API_URL="http://your.domain:3000"

# ============================================
# Environment
# ============================================

NODE_ENV="development"
# Other values: production, staging
